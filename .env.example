# DRISHTI configuration template. Copy to .env and fill in; .env is never committed.
# Environment variables with the same names override values in .env.

# Gemini, for the plain-language explanations (scripts/explain.py). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Multimodal model (images + text)
GEMINI_MODEL=gemini-3.8-flash

# Meteomatics weather API, for the possible-drivers analysis (scripts/drivers.py). https://www.meteomatics.com
METEOMATICS_USER=
METEOMATICS_PASSWORD=

# NASA Earthdata login (downloads) is NOT set here: earthaccess and hyp3_sdk read it from your
# _netrc / .netrc file in your home folder, or ask for it once. https://urs.earthdata.nasa.gov
